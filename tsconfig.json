{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": []
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.mjs"]
}
